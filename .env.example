# SMTP (server-side only — never expose to the browser)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password

# Where contact form submissions are delivered
CONTACT_EMAIL_TO=hello@medbuddy.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://medbuddy-app.com
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/medbuddy
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.medbuddy.app
